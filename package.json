{
  "name": "@pennyforgeorg/sendcheck-verify",
  "version": "0.2.1",
  "description": "Verify-before-pay client for the SendCheck x402 API: free address pre-check + the signed service card (ES256 JWS over the payTo and per-route maxPrice) \u2014 pin the key once, verify the payment challenge cryptographically before paying. Zero dependencies.",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test.mjs"
  },
  "keywords": [
    "address",
    "agent",
    "attestation",
    "base",
    "checksum",
    "drift",
    "eip-55",
    "es256",
    "evm",
    "jws",
    "payment",
    "pin",
    "signed",
    "usdc",
    "verify",
    "web3",
    "x402"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pennyforgeorg/sendcheck-verify.git"
  },
  "bugs": {
    "url": "https://github.com/pennyforgeorg/sendcheck-verify/issues"
  },
  "homepage": "https://pennyforge.org",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}